# WorkMail environment — HOSTED MODEL (Vercel + Cloudflare D1 + KV + Workers)
#
# These variables belong to the HOST (deployer: Flow99 / Priyadarshi), NOT to
# end users. End users never see or set these: they sign up in the app and
# enter only their domain, mailbox and provider API keys in Settings, which
# are encrypted server-side (AES-256-GCM) and never shown again.
# Deploy target: ONE Vercel project (repo root = app root) + ONE Cloudflare
# account holding the D1 database, the KV namespace and the Workers.
# Stack: Vercel + Cloudflare D1 + KV + Workers only. No other database
# or object-storage service is used.
# See README.md and docs/DEPLOY-CHECKLIST.md.

# Public app origin (deployed Vercel URL in production, e.g. https://mail.flow99.in)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare — single hosted account (D1 database + KV namespace + API token)
# The API token needs D1 Edit + KV Storage Edit permissions.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
CLOUDFLARE_API_TOKEN=cloudflare-api-token-with-d1-and-kv-edit
# DNS automation (domains/dns PUT) uses the same CLOUDFLARE_API_TOKEN plus:
CLOUDFLARE_ZONE_ID=your-flow99-in-zone-id

# Google OAuth — web-application client (Google Cloud Console, free).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/auth/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Webhook / ops tokens — generate long random values, never reuse across envs
# Generate with: openssl rand -base64 32
INBOUND_WEBHOOK_TOKEN=GENERATE_LONG_RANDOM_SECRET
DELIVERY_WEBHOOK_TOKEN=GENERATE_LONG_RANDOM_SECRET
OPS_CRON_TOKEN=GENERATE_LONG_RANDOM_SECRET

# Encrypts end-user provider API keys at rest (AES-256-GCM, 32 bytes base64).
# Losing this key makes all stored provider credentials undecryptable.
# Back it up offline BEFORE first use; there is no rotation flow yet.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=BASE64_32_BYTE_KEY

# First platform admin bootstrap (comma-separated emails; empty disables).
# On first Google login, a listed email is granted platform_admins.
PLATFORM_ADMIN_EMAILS=

# Operations (server-only)
ALERT_WEBHOOK_URL=

# MFA: 'true' requires TOTP enrollment for every user (see lib/guards.ts).
# When 'false', MFA is required only for users who enrolled a TOTP secret.
MFA_ENFORCEMENT=false

# Outbound fallback providers (host fallback only — workspace provider keys
# entered in Settings take precedence; see lib/providers.ts and
# docs/FREE-PROVIDER-QUOTAS.md). Chain order: SendPulse -> Brevo -> Mailjet
# -> Resend. Free tiers only, no card. Leave unconfigured providers unset;
# the chain skips them cleanly.
SENDPULSE_API_KEY=
SENDPULSE_API_SECRET=
BREVO_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
RESEND_API_KEY=

# AI agent (see lib/ai.ts and docs/AI-AGENT.md). Default path uses Cloudflare
# Workers AI via CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN (free
# 10,000 Neurons/day, no card) — no extra key needed. Optional BYOK
# OpenAI-compatible provider instead (key name only; never commit a value):
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
AI_MODEL=

# --- GitHub Actions secrets for backups (NOT Vercel env) ---
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_D1_DATABASE_ID,
# CLOUDFLARE_KV_NAMESPACE_ID, AGE_RECIPIENT (age public key), WORKMAIL_APP_URL,
# OPS_CRON_TOKEN. See .github/workflows/backup.yml and monitor.yml.
# --- Cloudflare Worker secrets (wrangler secret put, NOT Vercel) ---
# See cloudflare/api-worker/.env.example and
# cloudflare/inbound-email-worker/.env.example.
