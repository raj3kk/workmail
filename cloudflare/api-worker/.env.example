# Cloudflare api-worker secrets — set with `wrangler secret put`, never commit.
# APP_BEARER_TOKEN=long-random-secret
# INBOUND_WEBHOOK_TOKEN=must-match-the-Vercel-INBOUND_WEBHOOK_TOKEN
# BREVO_API_KEY=
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# RESEND_API_KEY=
# SENDPULSE_ID=
# SENDPULSE_SECRET=
# MAILTRAP_API_TOKEN=
# SMTP2GO_API_KEY=
# GAS_WEBHOOK_URL=
# GAS_SECRET=
# Optional vars (wrangler.toml [vars]): DEFAULT_MAILBOX=mailbox@example.com
# NOTE: single shared APP_BEARER_TOKEN for all callers — this worker is a
# single-workspace / private-test backend, NOT a multi-tenant API.
